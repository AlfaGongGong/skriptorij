MSG=$(git log -1 --pretty=%B | head -1); HEAD=$(git rev-parse --short HEAD)
TS=$(date +"%Y-%m-%d %H:%M")
LF="/storage/emulated/0/Download/BOOKLYFI_AI_LOG.md"
